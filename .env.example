# Copy to .env only when changing local runtime configuration.
# Keep provider credentials, model names and external service addresses out of source control.

APP_ENV=development
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
REDIS_HOST=
REDIS_PORT=
LLM_BACKEND=stub
LLM_PROVIDER=
LLM_ENDPOINT=
LLM_MODEL_ID=
LLM_INTAKE_MODEL_ID=
LLM_COVERAGE_MODEL_ID=
LLM_API_KEY=
LLM_JSON_MODE=true
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_INTAKE_INPUT_COST_PER_MILLION=
LLM_INTAKE_OUTPUT_COST_PER_MILLION=
LLM_COVERAGE_INPUT_COST_PER_MILLION=
LLM_COVERAGE_OUTPUT_COST_PER_MILLION=
LLM_STUB_DELAY_SECONDS=1.1
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_TARGETS=
CLIENT_RATE_LIMIT_PER_MINUTE=8
RUN_SLO_P95_SECONDS=15
CORPUS_FETCH_REMOTE=true
